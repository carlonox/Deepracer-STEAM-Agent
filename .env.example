# Copia este archivo como .env y reemplaza todos los valores CHANGE_ME.
# Nunca subas .env al repositorio.

# AWS DeepRacer
DEEPRACER_HOST=CHANGE_ME
DEEPRACER_SSH_PORT=22
DEEPRACER_SSH_USER=CHANGE_ME
DEEPRACER_SSH_PASSWORD=CHANGE_ME
DEEPRACER_API_PORT=5001
DEEPRACER_API_HTTPS=true
DEEPRACER_API_PASSWORD=CHANGE_ME

# Backend local
BACKEND_PORT=5002
DRIVE_TCP_PORT=5003
ALLOWED_ORIGIN=*

# Frontend (solo variables VITE_ se exponen al navegador)
VITE_AWS_HOST=CHANGE_ME

# VR en Quest por LAN (opcional, solo dev): con HTTPS el casco abre sesión
# XR y los controles fluyen; el proxy evita mixed-content (backend y cámara
# siguen en HTTP y vite los reenvía en mismo origen).
# En el .env real (nunca commitear, y jamás commitear .key/.crt):
# VITE_API_PROXY=1
# VITE_HTTPS_KEY=C:\ruta\fuera-del-repo\vr-lan.key
# VITE_HTTPS_CERT=C:\ruta\fuera-del-repo\vr-lan.crt

# Hermes y proveedor de modelos
OPENCODE_API_KEY=CHANGE_ME
OPENCODE_GO_API_KEY=CHANGE_ME
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=CHANGE_ME
HERMES_DASHBOARD_BASIC_AUTH_SECRET=CHANGE_ME
API_SERVER_KEY=CHANGE_ME

# RAG local. Ollama no valida esta clave, pero el cliente OpenAI exige un valor.
RAG_API_KEY=ollama-local

# Cámara ESP32
ESP32_CAMERA_WIFI_SSID=DeepRacer-Camera
ESP32_CAMERA_WIFI_PASSWORD=CHANGE_ME

# Zona muerta del throttle del robot (0-0.95). 0.5 = mínimo real de movimiento.
THROTTLE_DEAD_ZONE=0.5

# Trim de dirección: compensa la deriva del servo (negativo = corrige deriva a la derecha).
# ⚠️ El servo es muy sensible: -0.11 produce ~40°/s (giro de 90° en 2 s). Iterar desde -0.01.
STRAIGHT_ANGLE_OFFSET=-0.01
