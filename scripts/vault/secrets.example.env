# Plantilla del vault local (Opcion B: USB keyfile + PIN).
# 1. Copia este archivo a un .env LOCAL que NO se versionea.
# 2. Pon los valores reales (los mismos nombres que usa .env de la raiz).
# 3. Corre:  scripts/vault/init-vault.ps1 -SecretsFile <tu-archivo-local>
# 4. BORRA el archivo plano: el vault queda cifrado en secrets.age.
# NUNCA subas el archivo con valores ni este vault al repositorio.
DEEPRACER_SSH_USER=deepracer
DEEPRACER_SSH_PASSWORD=
DEEPRACER_API_PASSWORD=
OPENCODE_API_KEY=
OPENCODE_GO_API_KEY=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
API_SERVER_KEY=
ESP32_CAMERA_WIFI_PASSWORD=
